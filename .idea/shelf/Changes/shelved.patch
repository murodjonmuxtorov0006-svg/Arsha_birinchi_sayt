+import datetime
+
+from django.db.models import Q
+from django.shortcuts import render, get_object_or_404
+
+from .models import Email, Murojaat, Portfolio, Service, Team, Type
+
+
+def index(request):
+    q = request.GET.get('soz', '').strip()
+
+    works = Portfolio.objects.all()
+    services = Service.objects.all()
+    team_members = Team.objects.all()
+    types = Type.objects.all()
+
+    if q:
+        qidirish = (
+            Q(nomi__icontains=q)
+            | Q(company_name__icontains=q)
+            | Q(malumot__icontains=q)
+            | Q(tur__nomi__icontains=q)
+        )
+        works = Portfolio.objects.filter(qidirish)
+        types = Type.objects.filter(nomi__icontains=q)
+
+    if request.method == 'POST' and request.POST.get('form_type') == 'contact':
+        email = request.POST.get('email')
+        name = request.POST.get('name')
+        title = request.POST.get('title')
+        text = request.POST.get('text')
+        vaqt = datetime.datetime.now()
+        Murojaat(name=name, email=email, title=title, text=text, date=vaqt).save()
+
+    if request.method == 'POST' and request.POST.get('form_type') == 'subscribe':
+        email = request.POST.get('email')
+        Email(email=email).save()
+
+    context = {
+        'works': works,
+        'services': services,
+        'team_members': team_members,
+        'types': types,
+        'search_query': q,
+    }
+    return render(request, 'myapp/index.html', context)
+
+
+def filter_index(request, id):
+    works = Portfolio.objects.filter(tur_id=id)
+    services = Service.objects.all()
+    team_members = Team.objects.all()
+    types = Type.objects.all()
+    context = {
+        'works': works,
+        'services': services,
+        'team_members': team_members,
+        'types': types,
+    }
+    return render(request, 'myapp/index.html', context)
+
+
+def portfolio_details(request, pk):
+    work = get_object_or_404(Portfolio, pk=pk)
+    services = Service.objects.all()
+    team_members = Team.objects.all()
+    if request.method == 'POST':
+        email = request.POST.get('email')
+        Email(email=email).save()
+
+    context = {'work': work, 'services': services, 'team_members': team_members}
+    return render(request, 'myapp/portfolio_details.html', context)
