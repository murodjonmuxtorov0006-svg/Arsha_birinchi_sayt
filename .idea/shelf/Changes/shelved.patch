+    rasm = models.ImageField(upload_to='media', blank=True, null=True)
+
+    def __str__(self):
+        return self.nomi
+
+
+class Team(models.Model):
+    ismi = models.CharField(max_length=100)
+    lavozim = models.CharField(max_length=100)
